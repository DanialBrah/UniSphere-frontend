VITE_API_URL=http://localhost:8081
# SockJS requires HTTP(S) URL, not ws:// — the library handles the WebSocket upgrade internally
VITE_WS_URL=http://localhost:8081/ws

# ── Maps (Leaflet) ────────────────────────────────────────────────────────────
# NOTE: Vite inlines every VITE_* variable into the public client bundle. This file is
# build-time config, NOT a secret store. Nothing below is a secret — OpenStreetMap and
# CARTO tiles need no key. If you swap in a keyed provider (MapTiler, Stadia), put the key
# inside VITE_MAP_TILE_URL, set it in the Netlify/Vercel dashboard rather than committing
# it, and restrict it by HTTP referrer at the provider — it is readable in the shipped JS.
#
# Every variable here is optional — src/lib/mapConfig.ts carries the same values as
# hardcoded fallbacks, so the map works with none of them set.
#
# Whichever tile hosts you point at must also be allowed by the `img-src` directive of the
# Content-Security-Policy in vercel.json, or the tiles will be blocked in production.
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_URL_DARK=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
# Campus centre, "lat,lng". Matches the coordinates the backend's LostFoundSeeder seeds
# demo items around, so a local dev run lands on data instead of an empty ocean.
VITE_MAP_DEFAULT_CENTER=3.0678,101.5006
VITE_MAP_DEFAULT_ZOOM=16
VITE_MAP_MAX_ZOOM=19
